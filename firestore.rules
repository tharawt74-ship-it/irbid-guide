rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives & Security Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/supervisors/$(request.auth.uid)) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin' ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'supervisor'
          )
        ) ||
        (
          request.auth.token != null &&
          'isAdmin' in request.auth.token &&
          request.auth.token.isAdmin == true
        ) ||
        (
          request.auth.token != null &&
          'email' in request.auth.token &&
          (
            request.auth.token.email.matches('(?i)^princessofx2344@gmail\\.com$') ||
            request.auth.token.email.matches('(?i)^tharawt74@gmail\\.com$')
          )
        )
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Users & User Profiles Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && 
        incoming().keys().hasAll(['email']) && 
        (
          (!incoming().keys().hasAny(['role']) || incoming().role in ['user', 'merchant']) ||
          (
            incoming().role in ['super_admin', 'supervisor'] && 
            (
              incoming().email.matches('(?i)^princessofx2344@gmail\\.com$') ||
              incoming().email.matches('(?i)^tharawt74@gmail\\.com$')
            )
          )
        ) &&
        !incoming().keys().hasAny(['supervisorPermissions', 'customEmailVerified', 'isAdmin']);
      allow update: if isAdmin() || (
        isOwner(userId) && 
        (
          (!incoming().diff(existing()).affectedKeys().hasAny(['role']) || incoming().role in ['user', 'merchant']) ||
          (
            incoming().role in ['super_admin', 'supervisor'] && 
            (
              incoming().email.matches('(?i)^princessofx2344@gmail\\.com$') ||
              incoming().email.matches('(?i)^tharawt74@gmail\\.com$')
            )
          )
        ) &&
        !incoming().diff(existing()).affectedKeys().hasAny(['supervisorPermissions', 'customEmailVerified', 'isAdmin', 'emailVerified'])
      );
      allow delete: if isAdmin();
    }

    // 1b. Admins & Supervisors Collections
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() || (
        isSignedIn() && 
        request.auth.uid == adminId &&
        request.auth.token != null &&
        'email' in request.auth.token &&
        (
          request.auth.token.email.matches('(?i)^princessofx2344@gmail\\.com$') ||
          request.auth.token.email.matches('(?i)^tharawt74@gmail\\.com$')
        )
      );
    }

    match /supervisors/{supervisorId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 2. Businesses Collection
    match /businesses/{businessId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isSignedIn() && 
        incoming().userId == request.auth.uid &&
        !incoming().keys().hasAny([
          'isVip', 'vip', 'vipStatus', 'isFeatured', 'featured', 
          'isVerified', 'verified',
          'rating', 'reviewCount', 'vipStartDate', 'vipEndDate',
          'featuredStartDate', 'featuredExpiryDate', 'approved',
          'packagePlan', 'vipSubscriptionStartsAt', 'vipSubscriptionExpiresAt',
          'isVipTrial', 'isVipScheduled', 'tier'
        ])
      );
      allow update: if (
        (isSignedIn() && (
          isAdmin() || 
          (
            (
              (existing().userId != null && existing().userId == request.auth.uid) ||
              (existing().ownerId != null && existing().ownerId == request.auth.uid) ||
              (request.auth.token.email != null && (
                (existing().ownerEmail != null && existing().ownerEmail == request.auth.token.email) ||
                (existing().userEmail != null && existing().userEmail == request.auth.token.email)
              ))
            ) &&
            !incoming().diff(existing()).affectedKeys().hasAny([
              'approved', 'vipStatus', 'isVip', 'vip', 'sponsored', 'isFeatured', 'featured', 
              'isVerified', 'verified',
              'ownerId', 'userId', 'rating', 'reviewCount', 'vipStartDate', 'vipEndDate',
              'featuredStartDate', 'featuredExpiryDate', 'packagePlan', 'vipSubscriptionStartsAt',
              'vipSubscriptionExpiresAt', 'isVipTrial', 'isVipScheduled', 'tier'
            ])
          ) ||
          // Allow signed-in business manager/owner to update menu items or dish availability directly
          (
            incoming().diff(existing()).affectedKeys().hasAny(['menuItems']) &&
            !incoming().diff(existing()).affectedKeys().hasAny([
              'approved', 'vipStatus', 'isVip', 'vip', 'sponsored', 'isFeatured', 'featured', 
              'isVerified', 'verified',
              'ownerId', 'userId', 'rating', 'reviewCount', 'vipStartDate', 'vipEndDate',
              'featuredStartDate', 'featuredExpiryDate', 'packagePlan', 'vipSubscriptionStartsAt',
              'vipSubscriptionExpiresAt', 'isVipTrial', 'isVipScheduled', 'tier'
            ])
          ) ||
          // Allow linking/claiming the business if it has no owner yet and the incoming userId is the signed in user
          (
            (existing().userId == null || existing().userId == "" || existing().userId == "none") &&
            incoming().userId == request.auth.uid &&
            !incoming().diff(existing()).affectedKeys().hasAny([
              'approved', 'vipStatus', 'isVip', 'vip', 'sponsored', 'isFeatured', 'featured', 
              'rating', 'reviewCount', 'vipStartDate', 'vipEndDate',
              'featuredStartDate', 'featuredExpiryDate', 'packagePlan', 'vipSubscriptionStartsAt',
              'vipSubscriptionExpiresAt', 'isVipTrial', 'isVipScheduled', 'tier'
            ])
          )
        )) ||
        // Allow public interaction incrementing (views, clicks, analytics) safely without allowing arbitrary manipulation of ratings
        (
          !incoming().diff(existing()).affectedKeys().hasAny([
            'approved', 'vipStatus', 'isVip', 'vip', 'sponsored', 'isFeatured', 'featured', 
            'isVerified', 'verified', 'menuItems', 'name', 'phone', 'address', 'category',
            'ownerId', 'userId', 'rating', 'reviewCount'
          ])
        )
      );
      allow delete: if isAdmin() || (
        isSignedIn() && (
          (existing().userId != null && existing().userId == request.auth.uid) ||
          (existing().ownerId != null && existing().ownerId == request.auth.uid)
        )
      );
    }

    // 3. Business Requests Collection (Submission for verification/addition)
    match /businessRequests/{requestId} {
      allow read: if isSignedIn() && (isAdmin() || existing().userId == request.auth.uid);
      allow create: if isAdmin() || (
        isSignedIn() && 
        (incoming().userId == request.auth.uid || !('userId' in incoming()) || incoming().userId == '') && 
        incoming().status == 'pending'
      ) || (
        // Allow public/guest requests for business registration strictly in pending status
        incoming().status == 'pending'
      );
      allow update: if isAdmin() || (
        isSignedIn() && 
        existing().userId == request.auth.uid && 
        !incoming().diff(existing()).affectedKeys().hasAny(['status', 'userId'])
      );
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    // 4. Reviews Collection (Secured with schema validation & guest QR reviews)
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if (
        (
          (isSignedIn() && incoming().userId == request.auth.uid) ||
          (incoming().userId is string && incoming().userId.matches('^guest-.*'))
        ) &&
        incoming().rating is number && incoming().rating >= 1 && incoming().rating <= 5 &&
        incoming().businessId is string && incoming().businessId.size() <= 128 &&
        incoming().comment is string && incoming().comment.size() <= 2000 &&
        (!('userName' in incoming()) || (incoming().userName is string && incoming().userName.size() <= 100)) &&
        (!('userPhone' in incoming()) || (incoming().userPhone is string && incoming().userPhone.size() <= 50)) &&
        (!('deviceFingerprint' in incoming()) || (incoming().deviceFingerprint is string && incoming().deviceFingerprint.size() <= 128))
      );
      allow update: if isAdmin() || (
        isSignedIn() && 
        (
          (
            existing().userId == request.auth.uid &&
            !incoming().diff(existing()).affectedKeys().hasAny(['userId', 'businessId', 'reply'])
          ) ||
          (
            (
              get(/databases/$(database)/documents/businesses/$(existing().businessId)).data.userId == request.auth.uid ||
              get(/databases/$(database)/documents/businesses/$(existing().businessId)).data.ownerId == request.auth.uid
            ) &&
            !incoming().diff(existing()).affectedKeys().hasAny(['userId', 'businessId', 'rating', 'review', 'comment', 'createdAt', 'userName', 'userPhoto'])
          )
        )
      );
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    // 5. Job Offers Collection
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isSignedIn() && 
        incoming().userId == request.auth.uid && 
        incoming().status == 'pending'
      );
      allow update: if isAdmin() || (
        isSignedIn() && 
        existing().userId == request.auth.uid &&
        !incoming().diff(existing()).affectedKeys().hasAny(['status', 'approvedAt', 'userId'])
      );
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    // 6. Offers & Discounts Collection
    match /offers/{offerId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isSignedIn() && 
        incoming().userId == request.auth.uid && 
        incoming().status == 'pending'
      );
      allow update: if isAdmin() || (
        isSignedIn() && 
        existing().userId == request.auth.uid &&
        !incoming().diff(existing()).affectedKeys().hasAny(['status', 'approvedAt', 'userId'])
      );
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    // 7. Housing & Real Estate Collection
    match /housings/{housingId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isSignedIn() && 
        incoming().userId == request.auth.uid && 
        incoming().status == 'pending'
      );
      allow update: if isAdmin() || (
        isSignedIn() && 
        existing().userId == request.auth.uid &&
        !incoming().diff(existing()).affectedKeys().hasAny(['status', 'approvedAt', 'userId'])
      );
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    // 8. Messages & Legacy Conversations Collection
    match /messages/{messageId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        existing().senderId == request.auth.uid || 
        existing().receiverId == request.auth.uid
      );
      allow create: if isSignedIn() && incoming().senderId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && existing().senderId == request.auth.uid);
    }

    // 8b. Chat Rooms and Nested Messages
    match /chatRooms/{roomId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid || 
        resource.data.businessOwnerId == request.auth.uid
      );
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid || 
        request.resource.data.businessOwnerId == request.auth.uid
      );
      allow update: if isSignedIn() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid || 
        resource.data.businessOwnerId == request.auth.uid
      );
      allow delete: if isAdmin() || (
        isSignedIn() && (
          resource.data.userId == request.auth.uid || 
          resource.data.businessOwnerId == request.auth.uid
        )
      );

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && incoming().senderId == request.auth.uid;
        allow update, delete: if isAdmin() || (isSignedIn() && existing().senderId == request.auth.uid);
      }
    }

    // 9. Marketing Requests Collection
    match /marketingRequests/{marketingId} {
      allow read: if isSignedIn() && (isAdmin() || existing().userId == request.auth.uid);
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    // 10. Banner Booking Requests Collection (Hardened Schema)
    match /bannerBookingRequests/{bookingId} {
      allow read: if isSignedIn() && (isAdmin() || existing().userId == request.auth.uid);
      allow create: if (
        incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 100 &&
        incoming().phone is string && incoming().phone.size() > 0 && incoming().phone.size() <= 50 &&
        (!('email' in incoming()) || (incoming().email is string && incoming().email.size() <= 120)) &&
        (!('businessName' in incoming()) || (incoming().businessName is string && incoming().businessName.size() <= 120))
      );
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    // 11. App Notifications Collection
    match /notifications/{notificationId} {
      allow read: if true;
      allow create: if isAdmin() || (isSignedIn() && incoming().userId == request.auth.uid);
      allow update: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid && incoming().userId == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    // 12. App Configuration & System Settings Collections
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /systemConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /medical_categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /medical_facilities/{facilityId} {
      allow read: if true;
      allow create: if isAdmin() || (isSignedIn() && incoming().userId == request.auth.uid);
      allow update, delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    match /neighborhoods/{neighborhoodId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /vip_plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 13. Homepage Banners Collection
    match /banners/{bannerId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 15. Custom Verification Tokens Collection
    match /verification_tokens/{tokenId} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn() && incoming().uid == request.auth.uid;
      allow delete: if true;
    }

    // 15b. Deleted Emails Registry
    match /deleted_emails/{emailId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 16. News Collection
    match /news/{newsId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 17. Tourism Collection
    match /tourism/{tourismId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 17b. Transportation Collection
    match /transportation/{transportId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 19. Edit Suggestions Collection
    match /edit_suggestions/{suggestionId} {
      allow read: if isSignedIn() && isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // 20. Review Reports Collection
    match /review_reports/{reportId} {
      allow read: if isSignedIn() && isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // 21. Audit Logs (Append-only security trail)
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // 22. VIP Upgrade Requests Collection
    match /upgradeRequests/{reqId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && incoming().status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    // 23. Ownership Claims Collection
    match /ownership_claims/{claimId} {
      allow read: if isSignedIn() && (isAdmin() || existing().userId == request.auth.uid);
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    // 24. Housing Bookings Collection
    match /housing_bookings/{bookingId} {
      allow read: if isSignedIn() && (isAdmin() || existing().userId == request.auth.uid || existing().ownerId == request.auth.uid);
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    // 25. Roommates Collection
    match /roommates/{roommateId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    // 26. Missing Places (AI Leads) Collection
    match /missing_places/{placeId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // 27. Device Tokens for Push Notifications (Hardened schema & bounds)
    match /deviceTokens/{tokenId} {
      allow read: if isAdmin();
      allow create, update: if (
        incoming().token is string && incoming().token.size() >= 10 && incoming().token.size() <= 512 &&
        (!('userId' in incoming()) || incoming().userId is string) &&
        (!('platform' in incoming()) || incoming().platform is string)
      );
      allow delete: if isAdmin();
    }

    // 28. User Rewards Collection
    match /user_rewards/{rewardId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isAdmin() || (
        isSignedIn() && 
        !incoming().diff(existing()).affectedKeys().hasAny(['userId', 'businessId', 'businessName', 'code', 'discountPercent', 'createdAt', 'expiresAt'])
      );
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    // 29. Redeemed Codes Registry (Single-Use coupon protection)
    match /redeemed_codes/{codeId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if (
        (isSignedIn() || isAdmin()) &&
        incoming().code is string && incoming().code.size() <= 64 &&
        incoming().used == true
      );
      allow delete: if isAdmin();
    }

    // 30. Business Posts / News Collection (VIP Store Posts - Hardened permissions)
    match /business_posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        isAdmin() ||
        incoming().userId == request.auth.uid ||
        incoming().authorId == request.auth.uid
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        existing().userId == request.auth.uid ||
        existing().authorId == request.auth.uid
      );
      allow delete: if isAdmin() || (
        isSignedIn() && (
          existing().userId == request.auth.uid ||
          existing().authorId == request.auth.uid
        )
      );
    }
    match /business_posts/{postId}/{sub=**} {
      allow read: if true;
      allow write: if isAdmin() || (
        isSignedIn() && (
          get(/databases/$(database)/documents/business_posts/$(postId)).data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/business_posts/$(postId)).data.authorId == request.auth.uid
        )
      );
    }

    // 31. Orders Collection (Real-time Restaurant Orders - Hardened against tampering)
    match /orders/{orderId} {
      allow create: if incoming().businessId is string && incoming().businessId.size() > 0 && incoming().businessId.size() <= 128;
      allow get: if true;
      allow list: if isAdmin() || (isSignedIn() && (
        (resource.data.userId != null && resource.data.userId == request.auth.uid) ||
        (
          resource.data.businessId != null &&
          exists(/databases/$(database)/documents/businesses/$(resource.data.businessId)) &&
          (
            get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.userId == request.auth.uid ||
            get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.ownerId == request.auth.uid
          )
        )
      ));
      allow update, delete: if isAdmin() || (isSignedIn() && (
        resource.data.businessId != null &&
        exists(/databases/$(database)/documents/businesses/$(resource.data.businessId)) &&
        (
          get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.ownerId == request.auth.uid
        )
      ));
    }

    // 32. Reviews Locks Collection (Multi-device/multi-browser duplicate protection)
    match /reviews_locks/{lockId} {
      allow read: if true;
      allow create, update: if (
        (isSignedIn() && lockId.startsWith(request.auth.uid)) ||
        lockId.startsWith('guest-') ||
        lockId.startsWith('phone_')
      );
      allow delete: if isAdmin();
    }
  }
}
